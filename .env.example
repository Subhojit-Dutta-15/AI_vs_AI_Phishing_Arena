# Copy to .env (never commit .env). Export before running: set -a; source .env; set +a
GROQ_API_KEY=gsk_your_key_here
# Optional: comma-separated pool for automatic rate-limit failover
# GROQ_API_KEYS=gsk_key1,gsk_key2
# OPENAI_API_KEY=sk-...
# OLLAMA_BASE_URL=http://localhost:11434/v1

